#!/usr/bin/env bash
# ==============================================================================
# agyp: Antigravity Pool & Multi-Account Manager
# 다수의 Antigravity 계정 등록, 자동 Failover 풀링 및 수동 계정 선택을 지원하는 CLI 래퍼
# ==============================================================================

set -e

GATEWAY_PORT="${MAGPIE_PORT:-3425}"
GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
DEFAULT_KEY="magpie"

# agy 바이너리 탐색
if command -v agy >/dev/null 2>&1; then
  REAL_AGY="$(command -v agy)"
elif [ -x "$HOME/.local/bin/agy" ]; then
  REAL_AGY="$HOME/.local/bin/agy"
else
  REAL_AGY="agy"
fi

# ANSI 색상 코드
BOLD="\033[1m"
GREEN="\033[32m"
YELLOW="\033[33m"
CYAN="\033[36m"
RED="\033[31m"
MUTED="\033[90m"
RESET="\033[0m"

# 게이트웨이 기동 확인 함수
check_gateway() {
  if ! curl -s --connect-timeout 1 "${GATEWAY_URL}/v1/models" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  Magpie 게이트웨이(${GATEWAY_URL})가 응답하지 않습니다.${RESET}"
    echo -e "   Magpie 앱을 실행하거나 백그라운드 서비스를 시작해 주십시오."
    echo -e "   ${MUTED}(직접 실행: magpie serve 또는 백그라운드 앱 실행)${RESET}\n"
    return 1
  fi
  return 0
}

# 계정 목록 조회
cmd_list() {
  echo -e "${BOLD}${CYAN}📋 [Antigravity 계정 풀 및 쿼터 현황]${RESET}"
  magpie accounts antigravity
}

# 계정 추가
cmd_add() {
  echo -e "${BOLD}${GREEN}➕ [새 Antigravity 계정 추가]${RESET}"
  echo -e "브라우저가 열리면 추가할 Google 계정으로 로그인해 주십시오..."
  magpie accounts add antigravity
}

# 주 계정 전환
cmd_switch() {
  local acct="$1"
  if [ -z "$acct" ]; then
    echo -e "${RED}오류: 전환할 계정의 이메일 또는 식별자를 입력해 주십시오.${RESET}"
    echo -e "사용법: agyp switch <이메일>"
    exit 1
  fi
  echo -e "${BOLD}${CYAN}🔄 [기본 활성 계정 전환] ➜ ${acct}${RESET}"
  magpie accounts switch antigravity "$acct"
}

# 상태 확인
cmd_status() {
  echo -e "${BOLD}🔍 [Antigravity Pool 상태 점검]${RESET}"
  if check_gateway; then
    echo -e "${GREEN}✓ Magpie 게이트웨이 정상 동작 중 (${GATEWAY_URL})${RESET}"
  fi
  echo ""
  cmd_list
}

# 도움말
cmd_help() {
  cat << 'EOF'
Antigravity Pool (agyp) - 다중 계정 Failover 풀링 및 선택 실행 도구

사용법:
  agyp [옵션] [agy 인자...]

기본 실행 (Failover 풀링 모드):
  agyp                          등록된 모든 Antigravity 계정이 자동 풀링되어 실행됩니다.
                                (주 계정 쿼터 소진 시 대기 계정으로 자동 페일오버)
  agyp -p "프롬프트"            비대화형 단일 프롬프트 실행
  agyp --model <모델>           특정 모델 지정 실행

수동 계정 선택 실행:
  agyp -a <계정> [agy 인자...]   특정 계정(이메일)을 1순위로 지정하여 실행
  agyp --account <계정> ...     동일

계정 관리 서브커맨드:
  agyp list | accounts          등록된 계정 목록 및 실시간 쿼터/활성 상태 조회
  agyp add                      새 구글/Antigravity 계정 추가 (브라우저 로그인)
  agyp switch <계정>            기본 1순위 주 계정 변경
  agyp status                   게이트웨이 및 풀링 연결 상태 점검
  agyp help                     본 도움말 출력
EOF
}

# 서브커맨드 처리
case "$1" in
  list|accounts|ls)
    cmd_list
    exit 0
    ;;
  add)
    cmd_add
    exit 0
    ;;
  switch|use)
    cmd_switch "$2"
    exit 0
    ;;
  status)
    cmd_status
    exit 0
    ;;
  help)
    cmd_help
    exit 0
    ;;
esac

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  if [ $# -eq 1 ]; then
    cmd_help
    exit 0
  fi
fi

# 게이트웨이 상태 확인
check_gateway || true

# -a 또는 --account 플래그 파싱
TARGET_ACCOUNT=""
REMAINING_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    -a|--account)
      if [ -n "$2" ]; then
        TARGET_ACCOUNT="$2"
        shift 2
      else
        echo -e "${RED}오류: $1 옵션 뒤에 계정 이메일을 입력해야 합니다.${RESET}"
        exit 1
      fi
      ;;
    -a=*|--account=*)
      TARGET_ACCOUNT="${1#*=}"
      shift
      ;;
    *)
      REMAINING_ARGS+=("$1")
      shift
      ;;
  esac
done

# 특정 계정 선택 옵션이 지정된 경우 1순위 계정 전환
if [ -n "$TARGET_ACCOUNT" ]; then
  echo -e "${BOLD}${CYAN}🎯 [계정 선택] ${TARGET_ACCOUNT} 계정으로 실행합니다...${RESET}"
  magpie accounts switch antigravity "$TARGET_ACCOUNT" >/dev/null 2>&1 || {
    echo -e "${YELLOW}경고: '${TARGET_ACCOUNT}' 계정 전환 실패 (등록되지 않은 계정일 수 있습니다). 기본 풀링으로 진행합니다.${RESET}"
  }
fi

# 게이트웨이 환경변수를 주입하여 실제 agy 바이너리 실행
export GOOGLE_GEMINI_BASE_URL="${GATEWAY_URL}"
export GEMINI_API_KEY="${DEFAULT_KEY}"

exec "$REAL_AGY" "${REMAINING_ARGS[@]}"
